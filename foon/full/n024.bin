  }
}
GXRenderer.PENDING = { p: null, u: null, texUsed: 0, ready: false };
self.GXRenderer = GXRenderer;

</script>
<script data-src="input.js">
// input.js - keyboard / mouse / gamepad / DSU phone -> emulated Wii Remote + Nunchuk (runtime/wpad.c Pad struct)
// or GameCube controller on port 1 (runtime/hw.c GcPad struct), chosen in Settings > Controls
// Bindings (keyboard and gamepad buttons) are changed in the "Controles" panel and kept in this browser.
'use strict';
const BTN = { LEFT: 0x0001, RIGHT: 0x0002, DOWN: 0x0004, UP: 0x0008, PLUS: 0x0010, TWO: 0x0100, ONE: 0x0200, B: 0x0400, A: 0x0800, MINUS: 0x1000, Z: 0x2000, C: 0x4000, HOME: 0x8000 };
const PAD_BYTES = 60;   // sizeof(Pad) in runtime/input.h

// action id -> [label, default keys, default gamepad buttons (standard mapping indices), mode]
// New Super Mario Bros. Wii holds the Wii Remote sideways: the player's left/right/up/down are the remote's
// D-pad up/down/right/left, 2 = jump / OK, 1 = run / fireball / back, shake = spin jump / pick up.
// The GameCube controller mode is kept for other games; NSMBW does not read it.
const ACTIONS = [
  ['MLEFT', 'Move left', ['ArrowLeft', 'KeyA'], [14], 'wii'],
  ['MRIGHT', 'Move right', ['ArrowRight', 'KeyD'], [15], 'wii'],
  ['MUP', 'Up (enter doors / climb)', ['ArrowUp', 'KeyW'], [12], 'wii'],
  ['MDOWN', 'Down (crouch / pipes)', ['ArrowDown', 'KeyS'], [13], 'wii'],
  ['TWO', '2 button: jump / OK', ['Space', 'KeyK'], [0, 3], 'wii'],
  ['ONE', '1 button: run / fireball / back', ['ShiftLeft', 'KeyJ'], [2, 1], 'wii'],
  ['SHAKE', 'Shake: spin jump / pick up', ['KeyE', 'KeyL'], [5, 7], 'wii'],
  ['PLUS', '+ button (pause)', ['Enter', 'KeyP'], [9], 'wii'],
  ['MINUS', '\u2212 button', ['Backspace', 'KeyM'], [8], 'wii'],
  ['A', 'A button', ['KeyQ'], [4], 'wii'],
  ['B', 'B button', ['KeyB'], [6], 'wii'],
  ['HOME', 'HOME button', ['KeyH'], [16], 'wii'],
  ['GA', 'A (accelerate / OK)', ['Space', 'Enter'], [0], 'gc'],
  ['GB', 'B (brake / back)', ['KeyX', 'Backspace'], [1], 'gc'],
  ['GX', 'X (look back)', ['KeyC'], [2], 'gc'],
  ['GY', 'Y', ['KeyV'], [3], 'gc'],
  ['GL', 'L (use item)', ['KeyQ'], [6, 4], 'gc'],
  ['GR', 'R (drift / hop)', ['ShiftLeft', 'KeyE'], [7, 5], 'gc'],
  ['GZ', 'Z', ['KeyZ'], [], 'gc'],
  ['GSTART', 'START (pause)', ['KeyP', 'Escape'], [9], 'gc'],
  ['GUP', 'D-pad up (trick)', ['ArrowUp'], [12], 'gc'],
  ['GDOWN', 'D-pad down', ['ArrowDown'], [13], 'gc'],
  ['GLEFT', 'D-pad left', ['ArrowLeft'], [14], 'gc'],
  ['GRIGHT', 'D-pad right', ['ArrowRight'], [15], 'gc'],
  ['GSUP', 'Stick up', ['KeyW'], [], 'gc'],
  ['GSDOWN', 'Stick down', ['KeyS'], [], 'gc'],
  ['GSLEFT', 'Stick left (steer)', ['KeyA'], [], 'gc'],
  ['GSRIGHT', 'Stick right (steer)', ['KeyD'], [], 'gc'],
  ['GCUP', 'C-stick up', ['KeyI'], [], 'gc'],
  ['GCDOWN', 'C-stick down', ['KeyK'], [], 'gc'],
  ['GCLEFT', 'C-stick left', ['KeyJ'], [], 'gc'],
  ['GCRIGHT', 'C-stick right', ['KeyL'], [], 'gc'],
];
const GC = { LEFT: 0x0001, RIGHT: 0x0002, DOWN: 0x0004, UP: 0x0008, Z: 0x0010, R: 0x0020, L: 0x0040, A: 0x0100, B: 0x0200, X: 0x0400, Y: 0x0800, START: 0x1000 };
const MODE_KEY = 'nsmbw-ctl-mode';
let gMode = (() => { try { return false ? 'gc' : 'wii'; } catch (e) { return 'wii'; } })();
const PAD_NAMES = ['A / Cross', 'B / Circle', 'X / Square', 'Y / Triangle', 'LB / L1', 'RB / R1', 'LT / L2', 'RT / R2',
  'Back / Share', 'Start / Options', 'L3 (left stick)', 'R3 (right stick)', 'D-pad \u2191', 'D-pad \u2193', 'D-pad \u2190', 'D-pad \u2192', 'Guide / PS'];
const BIND_KEY = 'nsmbw-binds-v1';
function defaultBinds() { const b = {}; for (const [id, , keys, pads] of ACTIONS) b[id] = { k: keys.slice(), p: pads.slice() }; return b; }
const modeOf = (id) => (ACTIONS.find((a) => a[0] === id) || [])[4];
function loadBinds() {
  const b = defaultBinds();
  try {
    const s = JSON.parse(localStorage.getItem(BIND_KEY) || 'null');
    if (s && typeof s === 'object') for (const id in b) if (s[id]) {
      if (Array.isArray(s[id].k)) b[id].k = s[id].k.filter((k) => typeof k === 'string').slice(0, 2);
      if (Array.isArray(s[id].p)) b[id].p = s[id].p.filter((k) => Number.isInteger(k) && k >= 0 && k < 32).slice(0, 2);
    }
  } catch (e) { /* storage unavailable: defaults */ }
  return b;
}
function saveBinds(b) { try { localStorage.setItem(BIND_KEY, JSON.stringify(b)); } catch (e) { /* ignore */ } }
function keyName(code) {
  if (!code) return '\u2014';
  return code.replace(/^Key/, '').replace(/^Digit/, '').replace(/^Arrow/, 'Arrow ').replace('Space', 'Space')
    .replace('ShiftLeft', 'L-Shift').replace('ShiftRight', 'R-Shift').replace('ControlLeft', 'L-Ctrl').replace('ControlRight', 'R-Ctrl')
    .replace('Up', '\u2191').replace('Down', '\u2193').replace('Left', '\u2190').replace('Right', '\u2192');
}
function padName(i) { return i === undefined ? '\u2014' : (PAD_NAMES[i] || `Button ${i}`); }

let gBinds = loadBinds();
let gKeyToActions = null, gPadToActions = null;
function rebuildMap() {
  gKeyToActions = new Map(); gPadToActions = new Map();
  for (const id in gBinds) {
    if (modeOf(id) !== gMode) continue;      // only the bindings of the controller in use
    for (const k of gBinds[id].k) { if (!gKeyToActions.has(k)) gKeyToActions.set(k, []); gKeyToActions.get(k).push(id); }
    for (const p of gBinds[id].p) { if (!gPadToActions.has(p)) gPadToActions.set(p, []); gPadToActions.get(p).push(id); }
  }
}
rebuildMap();
let gCapture = null;     // while the settings panel waits for a key: (code) => void
let gPadCapture = null;  // ... or for a gamepad button: (index) => void

function firstGamepad() { if (!navigator.getGamepads) return null; for (const g of navigator.getGamepads()) if (g && g.connected) return g; return null; }
const dz = (v, d = 0.18) => (Math.abs(v) < d ? 0 : (v - Math.sign(v) * d) / (1 - d));

// ---------------------------------------------------------------- DSU (cemuhook) - e.g. "DSU Remote" phone app
// The local launcher (serve.py / start-nsmbw-web.ps1) talks UDP to the phone(s); we poll /dsu/state, which
// returns one 100-byte pad packet per connected slot. Each slot gets a role chosen in the panel:
//  wiimote  - the app's "WiiMote" layout: Cross=A, Square=B, Triangle=1, Circle=2, Share=-, Options=+, PS=HOME,
//             D-pad, gyro -> pointer, touch = recenter, phone motion = Wii Remote motion (shake)
//  nunchuk  - phone motion = Nunchuk motion (shake it), stick = Nunchuk stick, Cross/ZL/ZR = Z, other buttons = C
//  classic  - the app's "Classic" layout used as Wiimote+Nunchuk: left stick = Nunchuk, right stick = pointer,
//             a=A, b=B, ZR=B, ZL=Z, L=C, R=shake Nunchuk, x=1, y=2, -,+,HOME, D-pad, phone motion = Wiimote
const DSU_KEY = 'nsmbw-dsu-v1';
const ROLES = { wiimote: 'Wiimote', nunchuk: 'Nunchuk', classic: 'Classic controller \u2192 Wii Remote+Nunchuk', off: 'Not used' };
function dsuSlot() { return { buttons: 0, stick: null, rstick: null, acc: null, gyro: null, touch: false, ts: 0n, fresh: 0, nshake: false, seen: 0 }; }
const DSU = {
  cfg: { host: '', port: 26760, sens: 1.0, invX: false, invY: false, auto: false, roles: ['wiimote', 'nunchuk', 'off', 'off'] },
  on: false, status: 'disconnected', slots: [dsuSlot(), dsuSlot(), dsuSlot(), dsuSlot()], live: [],
  load() { try { const s = JSON.parse(localStorage.getItem(DSU_KEY) || '{}'); Object.assign(this.cfg, s); if (!Array.isArray(this.cfg.roles) || this.cfg.roles.length !== 4) this.cfg.roles = ['wiimote', 'nunchuk', 'off', 'off']; } catch (e) { /* defaults */ } },
  save() { try { localStorage.setItem(DSU_KEY, JSON.stringify(this.cfg)); } catch (e) { /* ignore */ } },
  async connect() {
    const r = await fetch(`dsu/connect?host=${encodeURIComponent(this.cfg.host)}&port=${this.cfg.port | 0}`).catch(() => null);
    if (!r) { this.status = 'the launcher is not responding'; return false; }
    if (r.status === 404) { this.status = 'this launcher has no DSU bridge (update serve.py / the .ps1)'; return false; }
    const j = await r.json().catch(() => ({}));
    if (!j.ok) { this.status = j.error || 'error'; return false; }
    this.on = true; this.status = 'waiting for data from the phone\u2026'; this.poll(); return true;
  },
  clear() { this.slots = [dsuSlot(), dsuSlot(), dsuSlot(), dsuSlot()]; this.live = []; },
  async disconnect() { this.on = false; this.clear(); this.status = 'disconnected'; await fetch('dsu/disconnect').catch(() => null); },
  async poll() {
    if (this.polling) return; this.polling = true;
    while (this.on) {
      const r = await fetch('dsu/state', { cache: 'no-store' }).catch(() => null);
      if (r && r.status === 200) {
        const buf = await r.arrayBuffer(); if (!this.on) break;
        const live = [];
        for (let o = 0; o + 100 <= buf.byteLength; o += 100) { const d = new DataView(buf, o, 100); const s = d.getUint8(20) & 3; this.parse(s, d); live.push(s); }
        for (let s = 0; s < 4; s++) if (!live.includes(s)) this.slots[s] = dsuSlot();
        this.live = live;
        this.status = 'connected: ' + live.map((s) => `slot ${s + 1} = ${ROLES[this.cfg.roles[s]] || '?'}`).join(', ');
      } else {
        this.clear();
        if (this.on) this.status = r ? 'waiting for data from the phone\u2026 (right IP? same Wi-Fi network? app open?)' : 'the launcher is not responding';
        await new Promise((ok) => setTimeout(ok, 250));
      }
      await new Promise((ok) => setTimeout(ok, 4));
    }
    this.polling = false;
  },
  parse(slot, d) {
    const role = this.cfg.roles[slot] || 'off', S = this.slots[slot];
    const b1 = d.getUint8(36), b2 = d.getUint8(37), home = d.getUint8(38), touch = d.getUint8(39);
    const cross = b2 & 0x40, circle = b2 & 0x20, square = b2 & 0x80, tri = b2 & 0x10, l1 = b2 & 0x04, r1 = b2 & 0x08, l2 = b2 & 0x01, r2 = b2 & 0x02;
    let b = 0; S.nshake = false;
    const common = () => {
      if (b1 & 0x01) b |= BTN.MINUS; if (b1 & 0x08) b |= BTN.PLUS; if (home) b |= BTN.HOME;
      if (b1 & 0x10) b |= BTN.UP; if (b1 & 0x20) b |= BTN.RIGHT; if (b1 & 0x40) b |= BTN.DOWN; if (b1 & 0x80) b |= BTN.LEFT;
    };
    if (role === 'wiimote') {
      if (cross) b |= BTN.A; if (square) b |= BTN.B; if (tri) b |= BTN.ONE; if (circle) b |= BTN.TWO;
      if (l1 || l2) b |= BTN.Z; if (r1) b |= BTN.C; if (r2) b |= BTN.B; common();
    } else if (role === 'nunchuk') {
      if (cross || l2 || r2) b |= BTN.Z; if (circle || square || tri || l1 || r1) b |= BTN.C;
    } else if (role === 'classic') {
      if (cross) b |= BTN.A; if (circle || r2) b |= BTN.B; if (l2) b |= BTN.Z; if (l1) b |= BTN.C; if (tri) b |= BTN.ONE; if (square) b |= BTN.TWO;
      if (r1) S.nshake = true; common();
    }
    S.buttons = role === 'off' ? 0 : b; S.touch = !!touch && role !== 'nunchuk';
    const ax = (o) => Math.max(-1, Math.min(1, (d.getUint8(o) - 128) / 127));
    const lx = ax(40), ly = ax(41), rx = ax(42), ry = ax(43);
    S.stick = Math.hypot(lx, ly) > 0.2 ? [lx, ly] : null;
    S.rstick = Math.hypot(rx, ry) > 0.2 ? [rx, ry] : null;
    const ts = d.getBigUint64(68, true);
    if (ts !== S.ts) {
      const dt = S.ts && ts > S.ts ? Math.min(0.1, Number(ts - S.ts) / 1e6) : 0; S.ts = ts;
      S.acc = [d.getFloat32(76, true), d.getFloat32(80, true), d.getFloat32(84, true)];
      S.gyro = [d.getFloat32(88, true), d.getFloat32(92, true), d.getFloat32(96, true), dt];
      S.fresh++;
    }
  },
};
DSU.load();

function shakeWave(now, k = 1) { const ph = now / 40 * k; return [Math.sin(ph) * 2.5, Math.cos(ph * 1.3) * 2.5, 1 + Math.sin(ph * 0.7) * 2.5]; }

class PadInput {
  constructor(canvas, memory, addr) {
    this.canvas = canvas; this.memory = memory; this.addr = addr;
    this.keys = new Set(); this.mouseBtn = 0; this.px = 0; this.py = 0; this.shake = 0; this.nshake = 0; this.screen = 0;
    addEventListener('keydown', (e) => {
      if (gCapture || gPadCapture || (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT'))) return;
      if (gKeyToActions.has(e.code)) {
        e.preventDefault();
        // keep a focused button (e.g. "Iniciar") from also reacting to Space/Enter
        if (document.activeElement && document.activeElement.tagName === 'BUTTON') document.activeElement.blur();
      }
      this.keys.add(e.code);
    }, true);
    addEventListener('keyup', (e) => { this.keys.delete(e.code); if (gKeyToActions.has(e.code)) e.preventDefault(); }, true);
    addEventListener('blur', () => { this.keys.clear(); this.mouseBtn = 0; this.screen = 0; });
    // Mouse = pointer. Clicking the game captures the mouse (pointer lock, Esc releases it): then the mouse moves
    // the pointer by its movement, so it never leaves the game and can reach every edge (a bit past them, like
    // a real Wii Remote). Without the capture the pointer follows the cursor over the picture.
    const LIM = 1.25;
    const clamp = (v) => Math.max(-LIM, Math.min(LIM, v));
    this.locked = () => document.pointerLockElement === canvas;
    addEventListener('mousemove', (e) => {
      const r = canvas.getBoundingClientRect();
      if (this.locked()) { this.px = clamp(this.px + (e.movementX / r.width) * 2.2); this.py = clamp(this.py - (e.movementY / r.height) * 2.2); return; }
      if (e.target !== canvas && !(e.target && e.target.id === 'screen')) return;
      this.px = clamp((((e.clientX - r.left) / r.width) * 2 - 1) * 1.1); this.py = clamp((1 - ((e.clientY - r.top) / r.height) * 2) * 1.1);
    });
    canvas.addEventListener('mousedown', (e) => {
      e.preventDefault();
      if (!this.locked() && document.body.classList.contains('playing') && canvas.requestPointerLock) {
        try { const p = canvas.requestPointerLock(); if (p && p.catch) p.catch(() => {}); } catch (err) { /* not allowed */ }
        if (!this.lockHint) { this.lockHint = 1; if (self.UI) UI.toast('Mouse captured by the game · press Esc to release it'); }
        return;      // this click only captures the mouse
      }
      this.mouseBtn |= 1 << e.button;
    });
    addEventListener('mouseup', (e) => { this.mouseBtn &= ~(1 << e.button); });
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    this.lastT = performance.now();
    setInterval(() => this.update(), 4);
  }
  // buttons held from the on-screen bar (A+B etc.)
  hold(mask, on) { this.screen = on ? (this.screen | mask) : (this.screen & ~mask); }
  update() {
    const now = performance.now(), dt = Math.min(0.05, (now - this.lastT) / 1000); this.lastT = now;
    const act = new Set();
    for (const c of this.keys) { const a = gKeyToActions.get(c); if (a) for (const x of a) act.add(x); }
    let sx = 0, sy = 0;
    // gamepad (standard mapping): buttons through the bindings, left stick = Nunchuk, right stick = pointer
    const gp = gPadCapture ? null : firstGamepad();
    if (gp) {
      gp.buttons.forEach((bt, i) => { if (bt && (bt.pressed || bt.value > 0.5)) { const a = gPadToActions.get(i); if (a) for (const x of a) act.add(x); } });
      const lx = dz(gp.axes[0] || 0), ly = dz(gp.axes[1] || 0), rx = dz(gp.axes[2] || 0), ry = dz(gp.axes[3] || 0);
      if (lx || ly) { sx = lx; sy = -ly; }
      if (rx || ry) { this.px = Math.max(-1, Math.min(1, this.px + rx * 1.8 * dt)); this.py = Math.max(-1, Math.min(1, this.py - ry * 1.8 * dt)); }
    }
    let b = this.screen;
    for (const id of ['A', 'B', 'PLUS', 'MINUS', 'HOME', 'ONE', 'TWO']) if (act.has(id)) b |= BTN[id];
    // sideways Wii Remote: player directions -> D-pad rotated a quarter turn (left = up, right = down, up = right, down = left)
    if (act.has('MLEFT') || sx < -0.5) b |= BTN.UP;
    if (act.has('MRIGHT') || sx > 0.5) b |= BTN.DOWN;
    if (act.has('MUP') || sy > 0.5) b |= BTN.RIGHT;
    if (act.has('MDOWN') || sy < -0.5) b |= BTN.LEFT;
    sx = 0; sy = 0;
    if (act.has('AB')) b |= BTN.A | BTN.B;
    if (this.mouseBtn & 1) b |= BTN.A;
    if (this.mouseBtn & 6) b |= BTN.B;
    const kx = (act.has('SRIGHT') ? 1 : 0) - (act.has('SLEFT') ? 1 : 0), ky = (act.has('SUP') ? 1 : 0) - (act.has('SDOWN') ? 1 : 0);
    if (kx || ky) { sx = kx; sy = ky; }
    const pdx = (act.has('PRIGHT') ? 1 : 0) - (act.has('PLEFT') ? 1 : 0), pdy = (act.has('PUP') ? 1 : 0) - (act.has('PDOWN') ? 1 : 0);
    if (pdx || pdy) { this.px = Math.max(-1, Math.min(1, this.px + pdx * 1.6 * dt)); this.py = Math.max(-1, Math.min(1, this.py + pdy * 1.6 * dt)); }
    if (act.has('PCENTER')) { this.px = 0; this.py = 0; }
    if (act.has('SHAKE')) this.shake = now;
    if (act.has('NSHAKE')) this.nshake = now;
    let wacc = null, nacc = null;
    // phones
    if (DSU.on) {
      for (const s of DSU.live) {
        const S = DSU.slots[s], role = DSU.cfg.roles[s];
        if (role === 'off') continue;
        b |= S.buttons;
        if (S.nshake) this.nshake = now;
        if ((role === 'nunchuk' || role === 'classic') && S.stick && !(sx || sy)) { sx = S.stick[0]; sy = S.stick[1]; }
        if (role === 'wiimote' && S.stick && !(sx || sy)) { sx = S.stick[0]; sy = S.stick[1]; }
        if (S.touch) { this.px = 0; this.py = 0; }
        if (role === 'classic' && S.rstick) { this.px = Math.max(-1, Math.min(1, this.px + S.rstick[0] * 1.8 * dt)); this.py = Math.max(-1, Math.min(1, this.py + S.rstick[1] * 1.8 * dt)); }
        if (role === 'wiimote' && S.gyro && S.fresh !== S.seen) {
          S.seen = S.fresh;
          const [pitch, yaw, , gdt] = S.gyro, k = (2 / 40) * DSU.cfg.sens;     // ~40 degrees = full screen width
          this.px = Math.max(-1.2, Math.min(1.2, this.px - yaw * gdt * k * (DSU.cfg.invX ? -1 : 1)));
          this.py = Math.max(-1.2, Math.min(1.2, this.py + pitch * gdt * k * (DSU.cfg.invY ? -1 : 1)));
        }
        if (S.acc) {
          const a = [-S.acc[0], S.acc[2], S.acc[1]];
          if (role === 'nunchuk') nacc = a; else wacc = a;
        }
      }
    }
    let [ax, ay, az] = wacc || [0, 0, 1];
    if (now - this.shake < 350) [ax, ay, az] = shakeWave(now);
    let [nx, ny, nz] = nacc || [0, 0, 1];
    if (now - this.nshake < 350) [nx, ny, nz] = shakeWave(now, 1.1);
    const len = Math.hypot(sx, sy); if (len > 1) { sx /= len; sy /= len; }
    if (!this.gcAddr && window.__gcAddr) this.gcAddr = window.__gcAddr;
    if (this.gcAddr) {        // GameCube controller (port 1)
      const g = new DataView(this.memory.buffer, this.gcAddr, 32);
      let gb = 0, gx = 0, gy = 0, cx = 0, cy = 0, tl = 0, tr = 0;
      if (gMode === 'gc') {
        for (const [id, bit] of [['GA', GC.A], ['GB', GC.B], ['GX', GC.X], ['GY', GC.Y], ['GZ', GC.Z], ['GL', GC.L], ['GR', GC.R], ['GSTART', GC.START],
                                 ['GUP', GC.UP], ['GDOWN', GC.DOWN], ['GLEFT', GC.LEFT], ['GRIGHT', GC.RIGHT]]) if (act.has(id)) gb |= bit;
        if (this.mouseBtn & 1) gb |= GC.A;
        gx = (act.has('GSRIGHT') ? 1 : 0) - (act.has('GSLEFT') ? 1 : 0); gy = (act.has('GSUP') ? 1 : 0) - (act.has('GSDOWN') ? 1 : 0);
        cx = (act.has('GCRIGHT') ? 1 : 0) - (act.has('GCLEFT') ? 1 : 0); cy = (act.has('GCUP') ? 1 : 0) - (act.has('GCDOWN') ? 1 : 0);
        if (gp) {
          const lx = dz(gp.axes[0] || 0), ly = dz(gp.axes[1] || 0), rx = dz(gp.axes[2] || 0), ry = dz(gp.axes[3] || 0);
          if (lx || ly) { gx = lx; gy = -ly; }
          if (rx || ry) { cx = rx; cy = -ry; }
          tl = gp.buttons[6] ? gp.buttons[6].value || 0 : 0; tr = gp.buttons[7] ? gp.buttons[7].value || 0 : 0;
        }
        const gl = Math.hypot(gx, gy); if (gl > 1) { gx /= gl; gy /= gl; }
        b = 0; sx = 0; sy = 0;        // the Wii Remote stays idle
      }
      g.setUint32(4, gb, true); g.setFloat32(8, gx, true); g.setFloat32(12, gy, true);
      g.setFloat32(16, cx, true); g.setFloat32(20, cy, true); g.setFloat32(24, tl, true); g.setFloat32(28, tr, true);
    }
    const dv = new DataView(this.memory.buffer, this.addr, PAD_BYTES);
    dv.setInt32(16, b, true);
    dv.setFloat32(20, this.px, true); dv.setFloat32(24, this.py, true);
    dv.setFloat32(28, ax, true); dv.setFloat32(32, ay, true); dv.setFloat32(36, az, true);
    dv.setFloat32(40, sx, true); dv.setFloat32(44, sy, true);
    dv.setFloat32(48, nx, true); dv.setFloat32(52, ny, true); dv.setFloat32(56, nz, true);
  }
}

// ---------------------------------------------------------------- settings panel
function buildControlsPanel() {
  const panel = document.getElementById('controls');
  const body = panel.querySelector('tbody');
  const hint = panel.querySelector('.hint');
  const stopCapture = () => { gCapture = null; if (gPadCapture) { clearInterval(gPadCapture.timer); gPadCapture = null; } hint.textContent = ''; };
  const assign = (id, kind, slot, value) => {
    const list = gBinds[id][kind].slice();
    if (value === null) list.splice(slot, 1);
    else {
      for (const other in gBinds) if (modeOf(other) === gMode) gBinds[other][kind] = gBinds[other][kind].filter((k) => k !== value);   // one action per key/button
      const cur = gBinds[id][kind].filter((k) => k !== value); cur[Math.min(slot, cur.length)] = value; list.length = 0; list.push(...cur);
    }
    gBinds[id][kind] = [...new Set(list.filter((v) => v !== undefined && v !== null))].slice(0, 2);
    saveBinds(gBinds); rebuildMap(); render();
  };
  function render() {
    body.textContent = '';
    for (const [id, label, , , mode] of ACTIONS) {
      if (mode !== gMode) continue;
      const tr = document.createElement('tr');
      const th = document.createElement('td'); th.textContent = label; tr.appendChild(th);
      for (const [kind, slot] of [['k', 0], ['k', 1], ['p', 0], ['p', 1]]) {
        const td = document.createElement('td');
        const btn = document.createElement('button');
        btn.className = 'bind' + (kind === 'p' ? ' pad' : '');
        btn.textContent = kind === 'k' ? keyName(gBinds[id].k[slot]) : padName(gBinds[id].p[slot]);
        btn.onclick = () => {
          stopCapture(); render();
          const b2 = body.querySelectorAll('tr')[ACTIONS.filter((a) => a[4] === gMode).findIndex((a) => a[0] === id)].querySelectorAll('button')[(kind === 'k' ? 0 : 2) + slot];
          b2.textContent = kind === 'k' ? 'press a key\u2026' : 'press a controller button\u2026'; b2.classList.add('wait');
          if (kind === 'k') {
            hint.textContent = 'Press the new key (Backspace = clear, Esc = cancel).';
            gCapture = (code) => { stopCapture(); if (code === 'Escape') { render(); return; } assign(id, 'k', slot, code === 'Backspace' || code === 'Delete' ? null : code); };
          } else {
            const gp = firstGamepad();
            hint.textContent = gp ? 'Press the new button on the controller (Backspace = clear, Esc = cancel).' : 'No controller found: connect it and press any button so the browser detects it.';
            const base = new Set(); if (gp) gp.buttons.forEach((bt, i) => { if (bt.pressed) base.add(i); });
            gCapture = (code) => { if (code === 'Escape') { stopCapture(); render(); } else if (code === 'Backspace' || code === 'Delete') { stopCapture(); assign(id, 'p', slot, null); } };
            gPadCapture = { timer: setInterval(() => {
              const g = firstGamepad(); if (!g) return;
              g.buttons.forEach((bt, i) => { if (!bt.pressed) base.delete(i); });
              const i = g.buttons.findIndex((bt, k) => bt.pressed && !base.has(k));
              if (i >= 0) { stopCapture(); assign(id, 'p', slot, i); }
            }, 30) };
          }
        };
        td.appendChild(btn); tr.appendChild(td);
      }
      body.appendChild(tr);
    }
  }
  addEventListener('keydown', (e) => { if (gCapture) { e.preventDefault(); e.stopImmediatePropagation(); gCapture(e.code); } }, true);
  const modeSel = document.getElementById('ctl-mode');
  if (modeSel) {
    modeSel.value = gMode;
    modeSel.onchange = () => { stopCapture(); gMode = modeSel.value === 'gc' ? 'gc' : 'wii'; try { localStorage.setItem(MODE_KEY, gMode); } catch (e) { /* ignore */ } rebuildMap(); render(); };
  }
  panel.querySelector('#ctl-reset').onclick = () => { stopCapture(); gBinds = defaultBinds(); saveBinds(gBinds); rebuildMap(); render(); };
  panel.querySelector('#ctl-close').onclick = () => { stopCapture(); panel.hidden = true; };
  window.openControls = () => { stopCapture(); panel.hidden = false; render(); };
  const sb = document.getElementById('settings'); if (sb) sb.onclick = () => { stopCapture(); panel.hidden = !panel.hidden; if (!panel.hidden) render(); };
  // gamepad status line
  const gpst = document.getElementById('gp-status');
  setInterval(() => { const g = firstGamepad(); if (gpst) gpst.textContent = g ? `Controller detected: ${g.id}${g.mapping === 'standard' ? '' : ' (no standard mapping: check the buttons)'}` : 'No controller detected (connect it and press a button).'; }, 500);
  // on-screen A+B button (press and hold)
  const ab = document.getElementById('btn-ab');
  if (ab) {
    const set = (on) => (e) => { e.preventDefault(); if (window.__input) window.__input.hold(BTN.A | BTN.B, on); };
    ab.addEventListener('pointerdown', set(true)); ab.addEventListener('pointerup', set(false)); ab.addEventListener('pointerleave', set(false));
  }
  // DSU section
  const $ = (id) => document.getElementById(id);
  const st = $('dsu-status');
  $('dsu-host').value = DSU.cfg.host; $('dsu-port').value = DSU.cfg.port; $('dsu-sens').value = DSU.cfg.sens;
  $('dsu-invx').checked = DSU.cfg.invX; $('dsu-invy').checked = DSU.cfg.invY;
  for (let s = 0; s < 2; s++) {
    const sel = $(`dsu-role${s}`);
    for (const [v, t] of Object.entries(ROLES)) { const o = document.createElement('option'); o.value = v; o.textContent = t; sel.appendChild(o); }
    sel.value = DSU.cfg.roles[s];
  }
  const readCfg = () => {
    DSU.cfg.host = $('dsu-host').value.trim(); DSU.cfg.port = Number($('dsu-port').value) || 26760;
    DSU.cfg.sens = Number($('dsu-sens').value) || 1; DSU.cfg.invX = $('dsu-invx').checked; DSU.cfg.invY = $('dsu-invy').checked;
    DSU.cfg.roles[0] = $('dsu-role0').value; DSU.cfg.roles[1] = $('dsu-role1').value; DSU.save();
  };
  for (const id of ['dsu-sens', 'dsu-invx', 'dsu-invy', 'dsu-role0', 'dsu-role1']) $(id).onchange = readCfg;
  $('dsu-connect').onclick = async () => {
    readCfg();
    if (DSU.on) { await DSU.disconnect(); DSU.cfg.auto = false; }
    else { DSU.cfg.auto = await DSU.connect(); }
    DSU.save();
  };
  setInterval(() => { st.textContent = DSU.status; $('dsu-connect').textContent = DSU.on ? 'Disconnect' : 'Connect'; }, 300);
  if (DSU.cfg.auto && DSU.cfg.host) DSU.connect();
  render();
}
if (document.readyState === 'loading') addEventListener('DOMContentLoaded', buildControlsPanel); else buildControlsPanel();
self.PadInput = PadInput;
self.__binds = () => gBinds;
self.__ctlMode = () => gMode;
self.__dsu = DSU;

</script>
<script data-src="ui.js">
// ui.js - title screen, settings / credits overlays, in-game buttons, toasts. The game itself is started by
// rgh-host.js (window.RGH_UI.onPlay is set there).
'use strict';

const UI = (() => {
  const $ = (id) => document.getElementById(id);
  const KEY = 'nsmbw-ui-v1';
  let opts = { fps: false, info: false, shaderMode: 'hybrid', scale: 2 };
  try { Object.assign(opts, JSON.parse(localStorage.getItem(KEY) || '{}')); } catch (e) { /* defaults */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(opts)); } catch (e) { /* private mode */ } };
  const apply = () => {
    document.body.classList.toggle('show-info', !!opts.info);
    $('fps').hidden = !opts.fps;
    $('opt-fps').checked = !!opts.fps; $('opt-info').checked = !!opts.info; $('opt-shmode').value = opts.shaderMode; $('opt-scale').value = String(opts.scale || 2);
    if (window.__renderer) window.__renderer.uberOnly = opts.shaderMode === 'uber';
  };

  // ---- small Wii-like "pop" for the menu buttons (WebAudio, after the first click)
  let actx = null;
  function pop(freq = 880) {
    try {
      if (!actx) actx = new AudioContext();
      const t = actx.currentTime, o = actx.createOscillator(), g = actx.createGain();
      o.type = 'sine'; o.frequency.setValueAtTime(freq, t); o.frequency.exponentialRampToValueAtTime(freq * 1.5, t + 0.05);
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.12, t + 0.008); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
      o.connect(g).connect(actx.destination); o.start(t); o.stop(t + 0.13);
    } catch (e) { /* no audio */ }
  }

  // ---- fullscreen
  const isFull = () => !!document.fullscreenElement;
  async function fullscreen(on = !isFull()) {
    try { if (on && !isFull()) await document.documentElement.requestFullscreen({ navigationUI: 'hide' }); else if (!on && isFull()) await document.exitFullscreen(); } catch (e) { /* refused */ }
  }
  const fullLabel = () => { const t = isFull() ? 'Exit full screen' : 'Full screen'; $('hud-full').textContent = t; $('opt-full').textContent = isFull() ? 'Turn off' : 'Turn on'; };
  document.addEventListener('fullscreenchange', fullLabel);

  // ---- toasts
  function toast(text, icon) {
    const d = document.createElement('div'); d.className = 'toast';
    if (icon) { const i = document.createElement('img'); i.onerror = () => i.remove(); i.src = icon; i.alt = ''; d.appendChild(i); }
    d.appendChild(document.createTextNode(text));
    $('toasts').appendChild(d); setTimeout(() => d.remove(), 3300);
  }

  // ---- loading bar
  function progress(frac, text, sub) {
    $('barfill').style.width = `${Math.max(0, Math.min(1, frac)) * 100}%`;
    if (text !== undefined) $('loadtext').textContent = text;
    if (sub !== undefined) $('loadsub').textContent = sub;
  }

  function init() {
    apply(); fullLabel();
    // clock on the Wii-like strip
    const clock = () => {
      const d = new Date();
      $('clock').innerHTML = `${d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}<small>${d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' })}</small>`;
    };
    clock(); setInterval(clock, 10000);

    // title buttons
    for (const b of document.querySelectorAll('#menu .ibtn')) b.addEventListener('mouseenter', () => actx && pop(1250));
    $('t-settings').onclick = () => { pop(); window.openControls && window.openControls(); };
    $('t-credits').onclick = () => { pop(); $('credits').hidden = false; };
    $('credits-close').onclick = () => { $('credits').hidden = true; };
    for (const ov of [$('credits'), $('controls')]) ov.addEventListener('mousedown', (e) => { if (e.target === ov) { ov.hidden = true; } });
    addEventListener('keydown', (e) => { if (e.code === 'Escape') { $('credits').hidden = true; } });

    // settings tabs
    for (const t of document.querySelectorAll('.tab')) t.onclick = () => {
      for (const o of document.querySelectorAll('.tab')) o.classList.toggle('on', o === t);
      for (const p of document.querySelectorAll('.pane')) p.hidden = p.id !== t.dataset.pane;
      if (t.dataset.pane === 'p-video') countShaders();
    };
    $('opt-full').onclick = () => fullscreen();
    $('opt-fps').onchange = () => { opts.fps = $('opt-fps').checked; save(); apply(); };
    $('opt-info').onchange = () => { opts.info = $('opt-info').checked; save(); apply(); };
    $('opt-shmode').onchange = () => { opts.shaderMode = $('opt-shmode').value; save(); apply(); };
    $('opt-export').onclick = exportShaders;
    $('opt-scale').onchange = () => { opts.scale = Number($('opt-scale').value) || 2; save(); if (window.__renderer) toast('The new resolution is used the next time you press Play'); };

    // in-game buttons: shown while the mouse moves or the screen is touched, hidden 2.5 s later
    let hideT = 0;
    const wake = () => { document.body.classList.add('show-hud'); clearTimeout(hideT); hideT = setTimeout(() => { if (!$('hud').matches(':hover')) document.body.classList.remove('show-hud'); else wake(); }, 2500); };
    addEventListener('mousemove', () => { if (document.body.classList.contains('playing') && !document.pointerLockElement) wake(); });
    addEventListener('touchstart', () => { if (document.body.classList.contains('playing')) wake(); }, { passive: true });
    $('hud-full').onclick = () => fullscreen();

    // connection pills and toasts (controller, phone)
    let lastGp = null, lastDsu = null;
    setInterval(() => {
      const pads = navigator.getGamepads ? [...navigator.getGamepads()].filter(Boolean) : [];
      const gp = pads[0] ? pads[0].id.replace(/\s*\(.*$/, '') : null;
      $('gp-pill').textContent = gp ? `Controller: ${gp.slice(0, 28)}` : 'No controller'; $('gp-pill').classList.toggle('ok', !!gp);
      if (gp !== lastGp) { if (gp) toast(`Controller connected: ${gp.slice(0, 40)}`); else if (lastGp) toast('Controller disconnected'); lastGp = gp; }
      const dsu = typeof DSU !== 'undefined' ? DSU : null, live = !!(dsu && dsu.on && dsu.status.startsWith('connected'));
      $('dsu-pill').textContent = live ? 'DSU connected' : dsu && dsu.on ? 'DSU waiting\u2026' : 'DSU disconnected'; $('dsu-pill').classList.toggle('ok', live);
      if (lastDsu !== null && live !== lastDsu) toast(live ? 'Phone connected (DSU Remote)' : 'Phone disconnected', 'data:image/png;base64,');
      lastDsu = live;
    }, 500);
  }

  // ---- shaders seen in this browser (IndexedDB rgh-shaders): count / export as a shaders.bin-style file
  function shaderDB() { return new Promise((res, rej) => { const q = indexedDB.open('nsmbw-shaders-1', 1); q.onupgradeneeded = () => q.result.createObjectStore('s'); q.onsuccess = () => res(q.result); q.onerror = () => rej(q.error); }); }
  async function ownShaders() { try { const db = await shaderDB(); return await new Promise((res) => { const q = db.transaction('s').objectStore('s').getAll(); q.onsuccess = () => res(q.result || []); q.onerror = () => res([]); }); } catch (e) { return []; } }
  async function countShaders() { const n = (await ownShaders()).length; $('opt-shcount').textContent = `${n} shader states saved in this browser; they are precompiled automatically next time. You can export them to have them added to the port.`; }
  async function exportShaders() {
    const all = await ownShaders();
    if (!all.length) { toast('No saved shaders yet'); return; }
    const blob = new Blob(all.map((b) => new Uint8Array(b)), { type: 'application/octet-stream' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'nsmbw-shaders-seen.bin'; a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    toast(`${all.length} shaders exported`);
  }

  if (document.readyState === 'loading') addEventListener('DOMContentLoaded', init); else init();
  // the game stopped: say so (and where the log went) instead of leaving a frozen picture
  function crashed(what) {
    if (document.getElementById('crash')) return;
    const d = document.createElement('div'); d.id = 'crash'; d.className = 'overlay';
    d.innerHTML = `<div class="card" style="width:min(560px,calc(100vw - 32px));padding:28px 30px;text-align:center">
      <h2 style="margin:0 0 10px;color:var(--wii-deep);font:800 24px var(--round)">Oops, the game stopped</h2>
      <p style="margin:0 0 8px;color:var(--ink)">${what}</p>
      <p style="margin:0 0 18px;color:var(--ink-soft);font-size:13px">${new URLSearchParams(location.search).get('log') === '1' ? 'The log was saved to <b>nsmbw-log.txt</b> next to the page.' : 'Open the browser console for the log, or add <b>?log=1</b> to the address to save it as nsmbw-log.txt.'}</p>
      <button class="wbtn blue" onclick="location.reload()">Restart</button></div>`;
    document.body.appendChild(d);
  }
  return { opts, apply, toast, progress, fullscreen, pop, ownShaders, shaderDB, crashed };
})();
self.UI = UI;

</script>
<script data-src="rgh-host.js">
// rgh-host.js - page side: loads the recompiled game (rgh.wasm), creates the shared memory and one
// worker per guest fiber, prepares every shader on the loading screen, then runs the game and presents frames.
'use strict';

const logEl = document.getElementById('log');
const statusEl = document.getElementById('status');
const statsEl = document.getElementById('stats');
const fpsEl = document.getElementById('fps');
const localLauncher = ['localhost','127.0.0.1','[::1]'].includes(location.hostname);
const lines = [];
const T0 = performance.now();
// the log can also be handed to a local launcher, which saves it as nsmbw-log.txt (to look at a crash
// afterwards). Posting is off unless asked for with ?log=1: a plain static host has no /log endpoint,
// so by default nothing is posted anywhere and the log only lives in the page and the console.
const launcherPost = new URLSearchParams(location.search).get('log') === '1';
const logOut = []; let logNew = true, logBusy = false;
function logFlush() {
  if (!launcherPost || logBusy || !logOut.length || location.protocol === 'file:') return;
  logBusy = true;
  const body = logOut.splice(0).join('\n') + '\n';
  fetch('log' + (logNew ? '?new=1' : ''), { method: 'POST', body, keepalive: body.length < 60000 }).catch(() => {}).finally(() => { logBusy = false; });
  logNew = false;
}
setInterval(logFlush, 2000);
addEventListener('pagehide', logFlush);
document.addEventListener('visibilitychange', () => log(`[page] tab ${document.visibilityState === 'visible' ? 'visible' : 'hidden'}`));
function log(text) {
  lines.push(text); if (lines.length > 400) lines.splice(0, lines.length - 400);
  logEl.textContent = lines.join('\n'); logEl.scrollTop = logEl.scrollHeight;
  if (window.__rghLog) window.__rghLog(text);
  if (launcherPost && (!/^\[OSReport\]/.test(text) || logOut.length < 20000)) logOut.push(`[${((performance.now() - T0) / 1000).toFixed(1)}] ${text}`);
}
addEventListener('keydown', (e) => { if (e.code === 'F9' && window.__dbgReq) { e.preventDefault(); window.__dbgReq('F9'); UI.toast('Game state saved to the log'); } });
addEventListener('error', (e) => { log(`[page] error: ${e.message} (${e.filename}:${e.lineno})`); logFlush(); });
addEventListener('unhandledrejection', (e) => { log(`[page] promesa rechazada: ${e.reason && (e.reason.stack || e.reason.message) || e.reason}`); logFlush(); });
log(`[page] ${navigator.userAgent} · ${navigator.hardwareConcurrency} cores · ${Math.round((navigator.deviceMemory || 0))} GB`);

const params = new URLSearchParams(location.search);
const env = {};
for (const [k, v] of params) if (k.startsWith('RGH_')) env[k] = v;
// guest thread switches: spin briefly before sleeping (much faster wake-ups) when there are cores to spare
if (!env.RGH_SPIN) { const n = navigator.hardwareConcurrency || 4; env.RGH_SPIN = String(n >= 8 ? 100000 : n >= 6 ? 50000 : n >= 4 ? 15000 : 0); }
const NORENDER = params.has('norender');

// A user-selected directory becomes a read-only disc without a server upload.
// The File objects are transferred to game workers; their data is read in
// small synchronous slices only when a game thread requests it.
let localGameFiles = null;
const gameStatus = document.getElementById('game-status') || document.getElementById('loadsub') || { textContent: '' };
const folderInput = null;
function chooseSource() {
  const files = [...folderInput.files];
  const paths = files.map(f => (f.webkitRelativePath || f.name).replace(/\\/g,'/'));
  const boot = paths.find(p => /(^|\/)sys\/boot\.bin$/i.test(p));
  if (!boot) { gameStatus.textContent = 'Missing sys/boot.bin. Select the extracted partition folder.'; return; }
  const prefix = boot.slice(0, -'sys/boot.bin'.length);
  const candidates = files.flatMap((file,i) => paths[i].startsWith(prefix) ? [['game/'+paths[i].slice(prefix.length),file]] : []);
  if (!['game/sys/fst.bin','game/sys/main.dol'].every(key => candidates.some(([p])=>p===key))) {
    gameStatus.textContent = 'Missing sys/fst.bin or sys/main.dol. Select the folder with sys and files.';
    return;
  }
  localGameFiles = candidates;
  const size = candidates.reduce((n,[,f]) => n+f.size,0);
  gameStatus.textContent = `${candidates.length} files ready (${(size/1048576).toFixed(0)} MiB). Starting\u2026`;
  play();
}
const assetBasePromise = Promise.resolve(null);   // the disc is inside this page
const useLocalFiles=params.has('local');

let modulePromise=null;
function loadModule() {
  const start=performance.now();
  modulePromise = (params.get('wasm') ? WebAssembly.compileStreaming(fetch(params.get('wasm')))
    : RGHModuleLoader.load({onRetry:(n,e)=>log(`[wasm] retry ${n}: ${e?.message||e}`)}))
    .then(m=>{log(`[host] module compiled in ${((performance.now()-start)/1000).toFixed(1)} s`);return m;});
  modulePromise.catch(()=>{});
  return modulePromise;
}
if (crossOriginIsolated) loadModule();
const nandPromise = nandLoad();

// ---- renderer: created on the loading screen so that every shader is compiled before the game starts
let renderer = null;
function makeRenderer() {
  if (renderer || NORENDER) return renderer;
  const canvas = document.getElementById('view');
  const ws = env.RGH_WIDESCREEN !== '0';           // the console is set to 16:9 unless ?RGH_WIDESCREEN=0
  if (!ws) document.body.classList.add('ar43');
  canvas.width = ws ? 1706 : 1280; canvas.height = 960;
  try { renderer = new GXRenderer(canvas, null, 0, { scale: Math.max(1, Math.min(3, Number(env.RGH_SCALE || UI.opts.scale) || 2)) }); }
  catch (e) { log('[render] ' + e.message); return null; }
  renderer.onError = (e) => log('[render] ' + (e.stack || e.message || e));
  try { const gl = renderer.gl, d = gl.getExtension('WEBGL_debug_renderer_info'); log(`[render] GPU: ${d ? gl.getParameter(d.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER)} · parallel compile: ${renderer.parallel ? 'yes' : 'no'} · scale ${renderer.scale}`); } catch (e) { /* no info */ }
  canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); log('[render] WebGL CONTEXT LOST! (the graphics card or its driver was reset)'); logFlush(); UI.toast('The graphics card was reset: reload the page (F5) to continue'); });
  renderer.uberOnly = UI.opts.shaderMode === 'uber';
  if (!renderer.parallel) renderer.compilePerFrame = 1;   // without KHR_parallel_shader_compile (Firefox) every compile blocks
  window.__renderer = renderer;
  log('[render] WebGL2 ready');
  return renderer;
}

// ---- shader cache: the register state of every shader seen is kept in IndexedDB; shipped ones in shaders.bin
async function shaderList() {
  const all = [];
  try {
    const rsp = await fetch('shaders.bin', { cache: 'no-cache' });
    if (rsp.ok) { const b = await rsp.arrayBuffer(); for (let o = 0; o + 353 * 4 <= b.byteLength; o += 353 * 4) all.push(b.slice(o, o + 353 * 4)); }
  } catch (e) { /* optional */ }
  all.ownStart = all.length;
  for (const b of await UI.ownShaders()) all.push(b);
  return all;
}
// this browser's own shader list kept only states that give new code (it used to keep every state: tens of
// thousands that compiled to the same few thousand programs, and loading got slower every session)
async function compactOwnShaders(keep) {
  try {
    const db = await UI.shaderDB(), tx = db.transaction('s', 'readwrite'), os = tx.objectStore('s');
    os.clear(); keep.forEach((b, i) => os.put(b, 'u' + i));
    await new Promise((res) => { tx.oncomplete = res; tx.onerror = res; });
    log(`[render] browser shader list compacted to ${keep.length}`);
  } catch (e) { /* keep the old list */ }
}
async function keepNewShaders(r) {
  let db = null;
  try { db = await UI.shaderDB(); } catch (e) { return; }
  const pending = [];
  r.onNewProgram = (key, st) => { pending.push([key, st.buffer]); };
  setInterval(() => {
    if (!pending.length) return;
    try { const tx = db.transaction('s', 'readwrite'), os = tx.objectStore('s'); for (const [k, v] of pending.splice(0)) os.put(v, k); } catch (e) { /* ignore */ }
  }, 2000);
}
// Compile everything: hand every shader to the driver (it compiles them on its own threads), then draw with each
// finished one once so the driver also builds its final GPU code. onProgress(fraction, text). Resolves when done.
function prepareShaders(r, all, onProgress) {
  return new Promise((resolve) => {
    if (r.uberOnly) { onProgress(1, 'Mode: generic shader only'); resolve(); return; }
    let i = 0, j = 0; const progs = [], seen = new Set(), ownKeep = [], t00 = performance.now();
    const step = () => {
      const t0 = performance.now();
      while (i < all.length && performance.now() - t0 < 12) {
        const idx = i, st = new Uint32Array(all[i++]); const pr = r.warm(st);
        if (pr && !seen.has(pr)) { seen.add(pr); progs.push([pr, st[0]]); if (idx >= (all.ownStart ?? all.length)) ownKeep.push(all[idx]); }
      }
      while (j < progs.length && performance.now() - t0 < 24) { try { if (!r.prime(progs[j][0], progs[j][1])) break; } catch (e) { /* broken entry */ } j++; }
      const frac = 0.35 * (i / Math.max(1, all.length)) + 0.65 * (i < all.length ? 0 : j / Math.max(1, progs.length));
      onProgress(frac, i < all.length ? `Compiling shaders ${i} / ${all.length}` : `Preparing shaders on the GPU ${j} / ${progs.length}`);
      if (i < all.length || j < progs.length) setTimeout(step, 0);
      else {
        log(`[render] ${all.length} states \u2192 ${progs.length} shaders ready in ${((performance.now() - t00) / 1000).toFixed(1)} s`);
        const own = all.length - (all.ownStart ?? all.length);
        if (own > ownKeep.length * 1.2 + 50) compactOwnShaders(ownKeep);
        resolve();
      }
    };
    step();
  });
}

// ---- Play: loading screen, then the game
let started = false;
async function play() {
  if (started) return;
  const remoteBase = useLocalFiles ? null : await assetBasePromise;
  const title = document.getElementById('title');
  if (!crossOriginIsolated) {   // a file:// page can never get the shared memory the game needs
    const lt = document.getElementById('loadtext'), ls = document.getElementById('loadsub');
    if (lt) lt.textContent = 'Needs a local server';
    if (ls) ls.textContent = location.protocol === 'file:'
      ? 'This file was opened from disk. Browsers do not give file:// pages the shared memory the game runs in: start iniciar-nsmbw.bat or serve.py and open the address it prints.'
      : 'This page is not cross-origin isolated: serve it with iniciar-nsmbw.bat or serve.py (it sends the COOP and COEP headers).';
    log('[host] not cross-origin isolated (' + location.protocol + '): cannot start');
    return;
  }
  started = true;
  primeAudio();
  title.classList.remove('needs-game');
  title.classList.add('loading');
  const P = (f, t, s) => UI.progress(f, t, s);
  if (!crossOriginIsolated) { P(0, 'Cannot start', 'The page is not isolated (COOP/COEP): open it with the launcher / serve.py.'); log('ERROR: the page is not cross-origin isolated (COOP/COEP). Open it with serve.py.'); return; }
  P(0.02, 'Loading\u2026', 'Preparing the game');
  let skip = false;
  const skipBtn = document.getElementById('skip');
  const skipT = setTimeout(() => { skipBtn.style.display = 'inline-block'; }, 60000);
  skipBtn.onclick = () => { skip = true; };
  let module;
  try { module = await (modulePromise || loadModule()); }
  catch (first) {
    log(`[wasm] previous load failed: ${first?.message||first}`);
    try { module = await loadModule(); }
    catch (e) { P(0, 'Could not load the game', String(e.message || e)); started=false; return; }
  }
  const nand = await nandPromise;
  P(0.08, 'Loading\u2026', 'Reading shaders');
  const r = makeRenderer();
  if (r) {
    try { if (!r.uber) { r.uber = r.buildUber(); r.syncFinish(r.uber); } } catch (e) { log('[render] ubershader: ' + e.message); }
    keepNewShaders(r);
    const all = params.has('noshaderwarm') ? [] : await shaderList();
    log(`[render] precompiling ${all.length} shader states\u2026`);
    await Promise.race([
      prepareShaders(r, all, (f, s) => P(0.08 + 0.9 * f, `Loading\u2026 ${Math.round((0.08 + 0.9 * f) * 100)}%`, s + (r.parallel ? '' : ' · loads and runs smoother in Chrome or Edge'))),
      new Promise((res) => { const k = setInterval(() => { if (skip) { clearInterval(k); res(); } }, 100); }),
    ]);
  }
  clearTimeout(skipT);
  if (window.__rghPackReady) { P(0.97, 'Loading\u2026', 'Unpacking the game data'); await window.__rghPackReady; }
  if(remoteBase && !localGameFiles && !NORENDER) {
    P(1, 'Starting game\u2026', 'Reading the game data from the page');
    runGame(module,nand,remoteBase);
    await new Promise(resolve=>{
      const startAt=performance.now();
      const timer=setInterval(()=>{
        if ((window.__renderer?.stats?.xfbCopies||0)>0 ||
            /^(Stopped|Error)/.test(statusEl.textContent) ||
            performance.now()-startAt>90000){clearInterval(timer);resolve();}
      },100);
    });
  } else {
    P(1, 'Ready!', '');
    await new Promise((res) => setTimeout(res, 350));
    runGame(module,nand,remoteBase);
  }
  title.classList.add('gone');
  setTimeout(() => { title.hidden = true; }, 800);
  document.body.classList.add('playing');
}

function runGame(module, nand, remoteBase) {
  const memory = new WebAssembly.Memory({ initial: 4096, maximum: 16384, shared: true });
  const tidBuf = new Int32Array(new SharedArrayBuffer(4));
  if (nand) log(`[nand] saved game loaded (${nand.byteLength} bytes)`);
  const cfg = { base: remoteBase || new URL('./', location.href).href, env, nand, localFiles: localGameFiles, pack: (window.__rghPack && window.__rghPack.buf) || null, packIndex: (window.__rghPack && window.__rghPack.index) || null };
  const workers = [];
  function spawn(tid, arg) {
    const w = new Worker(window.__rghWorkerUrl || 'rgh-worker.js');
    w.onmessage = onMsg;
    w.onerror = (e) => { log(`[host] worker ${tid} error: ${e.message}`); logFlush(); };
    w.postMessage({ type: 'start', memory, module, cfg, tidBuf, tid, arg });
    workers.push(w);
  }
  function onMsg(e) {
    const m = e.data;
    if (m.type === 'log') log(m.text);
    else if (m.type === 'spawn') spawn(m.tid, m.arg);
    else if (m.type === 'ring') startRenderer(memory, m.addr);
    else if (m.type === 'dbg') { window.__dbgReq = (why) => { log(`[threads] dump requested (${why})`); Atomics.store(new Int32Array(memory.buffer, m.addr, 1), 0, 1); }; }
    else if (m.type === 'audio') startAudio(memory, m);
    else if (m.type === 'nand') nandSave(m.data);
    else if (m.type === 'pad' && !params.has('RGH_AUTOPRESS')) window.__input = new PadInput(document.getElementById('view'), memory, m.addr);
    else if (m.type === 'gcpad' && window.__input) window.__input.gcAddr = m.addr;
    else if (m.type === 'gcpad') window.__gcAddr = m.addr;
    else if (m.type === 'exit') { log(`[host] exit(${m.code})`); statusEl.textContent = 'Stopped'; logFlush(); UI.crashed(`The game stopped (code ${m.code}).`); }
    else if (m.type === 'crash') { log(`[host] hilo ${m.tid}: ${m.error}`); statusEl.textContent = 'Error (see log)'; logFlush(); UI.crashed('The game hit an error.'); }
  }
  spawn(0, 0);
  window.__rgh = { memory, workers };
  statusEl.textContent = 'Running';
  setInterval(() => {
    const r = window.__renderer;
    let perf = '', fpsLine = '';
    if (r && r.stats) {   // pictures shown per second, draw calls per picture, objects drawn with the ubershader
      const st = r.stats, p = statsEl._p || {}, xf = st.xfbCopies || st.xfb || 0, calls = st.calls || 0, pend = st.pending || 0;
      if (p.t) {
        const dt = (performance.now() - p.t) / 1000, nf = xf - p.xf, fps = nf / dt;
        perf = `${fps.toFixed(0)} fps · ${nf ? Math.round((calls - p.calls) / nf) : 0} calls/frame · `;
        fpsLine = `${fps.toFixed(0)} FPS`;
        if (pend > p.pend) { perf += 'compiling shaders · '; fpsLine += '  · new shader'; }
      }
      statsEl._p = { t: performance.now(), xf, calls, pend };
    }
    if (r && r.stats && window.__dbgReq) {
      const st = r.stats, q = statsEl._q || (statsEl._q = { n: 0, done: 0 });
      const lowDraws = q.d !== undefined && (st.draws - q.d) < 20 * Math.max(1, (st.xfbCopies | 0) - q.c), sameTex = q.t === st.texUploads;
      const quiet = !window.__audioLevel || window.__audioLevel() < 20;
      q.n = lowDraws && sameTex && quiet ? q.n + 1 : 0;
      if (q.n === 40 && q.done < 3) { q.done++; window.__dbgReq('looks stuck: still picture and no sound for 40 s'); }
      q.d = st.draws; q.c = st.xfbCopies | 0; q.t = st.texUploads;
      // total silence for 4 s while the game is running (a cutscene without its sound?): note the audio state once
      // a minute at most, so the log says what was playing
      q.s = quiet ? (q.s | 0) + 1 : 0;
      if (q.s === 4 && (!q.ls || performance.now() - q.ls > 60000) && (q.ns = (q.ns | 0) + 1) <= 20) { q.ls = performance.now(); window.__dbgReq('4 s of silence'); }
    }
    if (!(statsEl._n = (statsEl._n | 0) + 1) || statsEl._n % 10 === 0) {
      const st = r && r.stats ? r.stats : {};
      let ring = '';
      if (r && r.memory && r.ring) { const hh = new Int32Array(r.memory.buffer, r.ring, 8); ring = ` ring=${((Atomics.load(hh, 0) - Atomics.load(hh, 1)) >>> 0) >> 10} KB`; }
      if (window.__audioStat) log('[status] ' + window.__audioStat());
      log(`[status] ${perf}${ring} draws=${st.draws | 0} copies=${st.xfbCopies | 0} skipped=${st.skipped | 0} generic=${st.pending | 0} shaders=${st.progs | 0} new=${st.newShaders | 0} textures=${st.texUploads | 0} memory=${Math.round(memory.buffer.byteLength / 1048576)} MB threads=${workers.length}`);
    }
    statsEl.textContent = perf + `${workers.length} threads` + (r && r.stats ? ` · ${r.stats.draws} draws · ${r.stats.progs} shader states · ${r.stats.newShaders || 0} new · ${r.stats.texUploads} textures` : '');
    if (fpsEl && !fpsEl.hidden) fpsEl.textContent = fpsLine;
  }, 1000);
}
// no start menu: the game loads as soon as the page opens. Sound starts with the first key, click or touch
// (browsers only let a page play sound after the player did something on it).
document.getElementById('start').onclick = () => { UI.pop(660); play(); };
setTimeout(play, 0);   // automatically starts when a remote source or local server is configured

function startRenderer(memory, addr) {
  if (NORENDER) {   // performance tests: drop the GPU stream, only count frames
    const h = new Int32Array(memory.buffer, addr, 8), u32 = new Uint32Array(memory.buffer), size = h[3] >>> 0;
    const st = { frames: 0, draws: 0, progs: 0, texUploads: 0 }; window.__renderer = { stats: st }; Atomics.store(h, 2, 1);
    setInterval(() => { let r = Atomics.load(h, 1) >>> 0; const w = Atomics.load(h, 0) >>> 0;
      while (r !== w) { const b = (addr + 32 + (r % size)) >> 2, hdr = u32[b], t = hdr >>> 24; if (t === 8) { st.frames++; if (st.pend) { st.pend = 0; st.flips = (st.flips || 0) + 1; } } else if (t === 3) st.draws++; else if (t === 7 && u32[b + 1] === 0) { st.xfb = (st.xfb || 0) + 1; st.pend = 1; } else if (t === 10) { const f = new Int32Array(memory.buffer, u32[b + 6] & ~3, 1); Atomics.store(f, 0, 1); Atomics.notify(f, 0); } r = (r + (hdr & 0xFFFFFF) * 4) >>> 0; }
      Atomics.store(h, 1, r | 0); Atomics.notify(h, 1); }, 2);
    return;
  }
  const r = makeRenderer();
  if (!r) return;
  if (!r.uber) { try { r.uber = r.buildUber(); } catch (e) { log('[render] ubershader: ' + e.message); } }
  if (!r.onNewProgram) keepNewShaders(r);
  r.attach(memory, addr);
  // the game waits for EFB copies it reads back with the CPU: draw up to them as soon as it asks (h[5] counts requests)
  if (Atomics.waitAsync) {
    const hh = new Int32Array(memory.buffer, addr, 8);
    const urgent = (v) => { const res = Atomics.waitAsync(hh, 5, v); (res.async ? res.value : Promise.resolve()).then(() => { try { r.pump(30); } catch (e) { /* the frame loop reports errors */ } urgent(Atomics.load(hh, 5)); }); };
    urgent(Atomics.load(hh, 5));
  }
  // the loop must survive an error in one frame (before, one exception stopped the picture for good: 0 fps)
  let nerr = 0, lastRaf = performance.now(), lastPump = performance.now();
  const pumpSafe = (budget) => {
    lastPump = performance.now();
    try { r.pump(budget); }
    catch (e) { if (nerr++ < 30) log('[render] error in the loop: ' + (e.stack || e.message || e)); r.batch = null; r.invalidate(); }
  };
  const loop = () => { lastRaf = performance.now(); pumpSafe(14); requestAnimationFrame(loop); };
  // Watchdog: if the browser stops calling requestAnimationFrame (it does for hidden or covered windows, and
  // sometimes after a fullscreen change) the game would wait for the picture forever: keep the stream moving.
  // It also writes to the log what the picture stream was doing if it ever stops advancing.
  let lastR = -1, stuck = 0;
  setInterval(() => {
    const now = performance.now();
    if (now - lastRaf > 250 && now - lastPump > 100) pumpSafe(30);
    const hh = new Int32Array(memory.buffer, addr, 8), w = Atomics.load(hh, 0) >>> 0, rd = Atomics.load(hh, 1) >>> 0;
    if (w !== rd && rd === lastR) {
      if (++stuck === 30) {
        const off = rd % (hh[3] >>> 0), hdr = new Uint32Array(memory.buffer, addr + 32 + off, 4);
        log(`[render] drawing is not advancing! pending=${((w - rd) >>> 0) >> 10} KB record=${(hdr[0] >>> 24)}/${hdr[0] & 0xFFFFFF} ${hdr[1]} ${hdr[2]} raf=${Math.round(now - lastRaf)} ms pump=${Math.round(now - lastPump)} ms visible=${document.visibilityState} contexto=${r.gl.isContextLost() ? 'perdido' : 'ok'}`);
      }
    } else stuck = 0;
    lastR = rd;
  }, 100);
  requestAnimationFrame(loop);
}

let audioCtx = null;
function primeAudio() {   // created right away (suspended until the player presses something)
  // 24 kHz out: the music is resampled down anyway, and a lower output rate costs a quarter less audio
  // work per second, which is exactly what the ring needs when the page is busy
  try { audioCtx = new AudioContext({ sampleRate: 24000, latencyHint: 'interactive' }); } catch (e) { log('[audio] ' + e.message); return; }
  const wake = () => { if (audioCtx.state !== 'running') audioCtx.resume().catch(() => {}); if (audioCtx.state === 'running') for (const t of ['pointerdown', 'keydown', 'touchstart']) removeEventListener(t, wake, true); };
  for (const t of ['pointerdown', 'keydown', 'touchstart']) addEventListener(t, wake, true);
  setInterval(() => { if (audioCtx.state !== 'running' && navigator.getGamepads && [...navigator.getGamepads()].some((g) => g && g.buttons.some((b) => b.pressed))) wake(); }, 250);
}
async function startAudio(memory, m) {
  if (!audioCtx) { log('[audio] no audio context (press Play to enable sound)'); return; }
  try {
    await audioCtx.audioWorklet.addModule(window.__rghWorkletUrl || 'audio-worklet.js');
    const node = new AudioWorkletNode(audioCtx, 'rgh-audio', { outputChannelCount: [2], processorOptions: { memory, ring: m.ring, len: m.len, wpos: m.wpos, rpos: m.rpos } });
    node.connect(audioCtx.destination);
    // audio level and underruns, summarised every 10 s in the log
    const au = { rms: [], dry: 0, drop: 0, buf: 0 };
    node.port.onmessage = (e) => { const d = e.data; au.last = d.rms; au.rms.push(d.rms); au.dry += d.dry; au.drop += d.drop; au.buf = d.buf; au.target = d.target; au.step = d.step; au.ring = d.ring; au.prod = d.prod; au.skip = d.skip; au.grains = d.grains; };
    window.__audioLevel = () => au.last | 0;
    window.__audioStat = () => { const t = `audio: level ${au.rms.length ? Math.max(...au.rms) : 0} (min ${au.rms.length ? Math.min(...au.rms) : 0}) underruns=${au.dry} drops=${au.drop} buffer=${au.buf}/${au.target} ms guest=${au.prod ?? '?'} Hz step=${au.step ?? '?'} (${(((au.step ?? 1) / (32000 / audioCtx.sampleRate) - 1) * 100).toFixed(2)}% pitch) skip=${((au.skip ?? 0) * 100).toFixed(2)}% grains=${au.grains ?? 0} state=${audioCtx.state}`; au.rms = []; au.dry = 0; au.drop = 0; return t; };
    new Int32Array(memory.buffer, m.on, 1)[0] = 1;
    if (audioCtx.state !== 'running') audioCtx.resume().catch(() => {});
    log(`[audio] ${audioCtx.sampleRate} Hz${audioCtx.state === 'running' ? '' : ' (starts with the first key or click)'}`);
  } catch (e) { log('[audio] ' + e.message); }
}

// ---- NAND (save data, settings) persisted in IndexedDB of this browser
function idb() {
  return new Promise((res, rej) => { const r = indexedDB.open('nsmbw-web', 1); r.onupgradeneeded = () => r.result.createObjectStore('nand'); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); });
}
async function nandLoad() {
  try { const db = await idb(); return await new Promise((res) => { const q = db.transaction('nand').objectStore('nand').get('image'); q.onsuccess = () => res(q.result || null); q.onerror = () => res(null); }); }
  catch (e) { return null; }
}
async function nandSave(buf) {
  try { const db = await idb(); db.transaction('nand', 'readwrite').objectStore('nand').put(buf, 'image'); log(`[nand] saved (${buf.byteLength} bytes)`); }
  catch (e) { log('[nand] no se pudo guardar: ' + e.message); }
  nandBackup(buf);
}
// a copy of the save goes to the launcher too (nsmbw-save-backup.bin next to web/): a backup outside the browser
// (clearing the browser data would otherwise delete the game's progress)
let nandBackupT = 0, nandBackupBuf = null;
function nandBackup(buf) {
  if (location.protocol === 'file:' || !launcherPost || !buf) return;
  nandBackupBuf = buf; clearTimeout(nandBackupT);
  nandBackupT = setTimeout(() => { fetch('nand', { method: 'POST', body: nandBackupBuf }).catch(() => {}); nandBackupBuf = null; }, 1500);
}
nandPromise.then((b) => { if (b) nandBackup(b); });

</script>
<script>if (/^\/(rabbids|mkw|nsmbw)\//.test(location.pathname)) document.getElementById('hud-wiimenu').hidden = false;</script>
</body>
</html>
