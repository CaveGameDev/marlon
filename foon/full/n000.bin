        if (this.live) { this.st.dry++; this.live = false; this.target = Math.min(this.maxTarget, this.target + 1200); this.calm = 0; }
        this.lastL *= 0.9995; this.lastR *= 0.9995;
        this.ol = this.lastL; this.or = this.lastR;
