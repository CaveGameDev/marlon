        const hp = this.G - this.insLeft;
        let gl = this.grainL[hp], gr = this.grainR[hp];
        const edge = hp < this.XF || hp >= this.G - this.XF;
        if (edge && this.pa > 1) {            // blend the join with the live stream
          this.read();
